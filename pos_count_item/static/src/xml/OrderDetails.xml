<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderDisplay" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('order-summary')]" position="inside">
            <div class="pos-count-item-total d-flex justify-content-between w-100">
                <span>Items</span>
                <span t-esc="order.totalQuantity"/>
            </div>
        </xpath>
    </t>
</templates>
